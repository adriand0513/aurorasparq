# Copy to .env for local development. Never commit .env.

# Required
DATABASE_URL=postgresql://user:password@localhost:5432/aurorasparq
XAI_API_KEY=
JWT_SECRET=            # long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))"

# Model
XAI_MODEL=grok-4.20
XAI_TEMPERATURE=0.84
XAI_MAX_TOKENS=1024

# Voice notes (optional; voice is skipped if missing)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
AUDIO_DIR=/var/data/audio

# Stripe (optional; payments return 503 if missing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_ULTIMATE_MONTHLY=

# Site / plans
PUBLIC_BASE_URL=https://www.aurorasparq.com
FREE_DAILY_MESSAGE_LIMIT=5
